<IfModule mod_php.c>
    php_value upload_max_filesize 2048M
    php_value post_max_size 4096M
    php_value max_execution_time 3600
    php_value max_input_time 3600
    php_value memory_limit 512M
</IfModule>

# Berkas konfigurasi & data CMS tidak boleh diunduh langsung (folder includes/, views/, templates/, data/ punya .htaccess sendiri).
<FilesMatch "^(projects|cms-settings)\.json$|\.(log|bak)$">
    Require all denied
</FilesMatch>
Options -Indexes
